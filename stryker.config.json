{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "buildCommand": "npx nx run-many -t build --skip-nx-cache",
  "concurrency": 2,
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "testFiles": [
    "./**/*.spec.ts"
  ],
  "mutate": [
    "packages/shop/*/src/lib/**/*.ts",
    "packages/shared/models/src/**/*.ts",
    "!packages/shop/*/src/lib/**/*.spec.ts",
    "!packages/shared/models/src/**/*.spec.ts"
  ],
  "allowEmpty": true,
  "allowConsoleColors": true,
  "ignorePatterns": [
    "./**/node_modules/**",
    "./**/.nx/**",
    "./**/dist/**",
    "./**/reports/**",
    "./**/.stryker-tmp/**"
  ],
  "cleanTempDir": true,
  "ignoreStatic": true,
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation-report.json"
  },
  "clearTextReporter": {
    "allowColor": true,
    "logTests": true,
    "maxTestsToLog": 3
  }
}
